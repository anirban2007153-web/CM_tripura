# Express API
PORT=3001
CLIENT_ORIGIN=http://localhost:3000
# Supabase Auth. The publishable key is safe for browser use; never add a
# Supabase secret/service_role key to this file or any VITE_ variable.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Required only by the trusted authority provisioning command; never expose it to the browser.
SUPABASE_SECRET_KEY=sb_secret_your_key

# Optional: set this to a verified server-side map from exact area labels to
# department and jurisdiction. Unmapped complaint areas remain unassigned.
JURISDICTION_MAP_JSON={}

# Optional public API URL for a separately hosted API. Never put secrets here.
# VITE_CLEANMAP_API_URL=https://api.example.org

